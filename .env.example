# --- NVIDIA hosted inference (zero-shot baseline / comparison) ---
NVIDIA_API_KEY=
NVIDIA_CHAT_BASE_URL=https://inference-api.nvidia.com/v1
NVIDIA_REASONER_MODEL=nvidia/nvidia/cosmos3-super-reasoner

# --- TAO Fine-Tuning Microservices (FTMS) ---
# URL of your TAO API deployment (the FTMS control plane that fronts the cluster)
TAO_BASE_URL=https://tao-api.example.com
NGC_ORG_NAME=your_ngc_org
NGC_KEY=nvapi-xxxxxxxx
HF_TOKEN=hf_xxxxxxxx

# --- SLURM cluster the jobs are dispatched to ---
SLURM_USER=your_login
SLURM_HOSTNAME=login.cluster.example.com
SLURM_PARTITION=batch
SLURM_CLUSTER_NAME=mycluster
SLURM_BASE_RESULTS_DIR=/lustre/fsw/users/your_login/tao_results

# --- Where the generated dataset lives in cloud/cluster storage (uploaded by you) ---
# e.g. aws://bucket/tube_inspection/train  or a path inside the SLURM workspace
TRAIN_DATASET_URI=
EVAL_DATASET_URI=
